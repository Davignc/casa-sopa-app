DATABASE_URL=postgresql+psycopg://casa_sopa:casa_sopa@localhost:5432/casa_sopa
# Banco usado pela suite de testes (é recriado a cada execução).
TEST_DATABASE_URL=postgresql+psycopg://casa_sopa:casa_sopa@localhost:5432/casa_sopa_test

# Gere com: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cloudflare R2 / S3
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

ENVIRONMENT=development
