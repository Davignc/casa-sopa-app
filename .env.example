# --- Opção 1 (recomendada): PostgreSQL ---
DATABASE_URL=postgresql+psycopg://casa_sopa:casa_sopa@localhost:5432/casa_sopa
# Banco usado pela suite de testes (é recriado a cada execução).
TEST_DATABASE_URL=postgresql+psycopg://casa_sopa:casa_sopa@localhost:5432/casa_sopa_test

# --- Opção 2: SEM Docker/Postgres (SQLite, só para desenvolvimento e testes) ---
# Troque as duas linhas acima por estas:
# DATABASE_URL=sqlite:///./casa_sopa_dev.db
# TEST_DATABASE_URL=sqlite://

# Obrigatória, com no mínimo 32 caracteres.
# Gere com: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bloqueio de login: após N erros seguidos, espera M minutos (RF01).
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Custo do bcrypt (padrão 12). Em produção precisa ser >= 10.
# BCRYPT_ROUNDS=12

ENVIRONMENT=development

# Fuso para "hoje", "último mês" e limites de período dos relatórios.
TIMEZONE=America/Sao_Paulo

# Endereços do front-end autorizados a chamar a API (CORS), separados por vírgula.
# Vazio = nenhum. Ex.: CORS_ORIGINS=http://localhost:5173,https://sistema.casadasopa.org
CORS_ORIGINS=

# Pasta dos arquivos enviados pela administradora (logo da ONG).
UPLOADS_DIR=uploads

# Backup semanal do banco (RNF03). Em produção, ligue.
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_RETENCAO=8
BACKUP_DIA_SEMANA=sun
BACKUP_HORA=3
# Caminho do pg_dump, se não estiver no PATH (Windows: C:\Program Files\PostgreSQL\16\bin\pg_dump.exe)
# PG_DUMP_PATH=pg_dump
